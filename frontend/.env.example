# Backend URL. Restart `npx expo start` after changing this file.
#
# Browser on the same laptop:   http://localhost:5050/api
# Android emulator:             http://10.0.2.2:5050/api
# Real phone on same Wi-Fi:     http://<LAPTOP-IP>:5050/api
# Note: macOS often occupies port 5000 (AirPlay), so the API defaults to 5050.
EXPO_PUBLIC_API_URL=http://localhost:5050/api
