    "expo": "~57.0.30",
    "expo-constants": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.21",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.28",
    "expo-sharing": "~57.0.23",
