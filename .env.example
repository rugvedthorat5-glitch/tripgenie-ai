# Backend URL. Restart `npx expo start` after changing this file.
#
# Browser on the same laptop:   http://localhost:5000/api
# Android emulator:             http://10.0.2.2:5000/api
# Real phone on same Wi-Fi:     http://<LAPTOP-IP>:5000/api   (find it with: ipconfig)
EXPO_PUBLIC_API_URL=http://localhost:5000/api
