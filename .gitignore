# Dependencies
node_modules/
*/node_modules/

# Environment files
.env
.env.local
.env*.local
frontend/.env
backend/.env

# Expo & Web
.expo/
dist/
web-build/

# Android Native Build artifacts (crucial: avoids multi-gigabyte commits)
frontend/android/app/build/
frontend/android/.gradle/
frontend/android/build/
frontend/android/.cxx/
frontend/android/.idea/
frontend/android/*.iml
frontend/android/app/*.iml
frontend/android/local.properties

# Binary builds and archives (crucial: prevents GitHub >100MB file limit error)
*.apk
*.aab
*.zip

# System & logs
.DS_Store
*/.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
